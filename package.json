{
  "name": "react-tic-tac-toe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "rimraf ./build/**/*",
    "build": "webpack",
    "predeploy": "yarn build --mode production",
    "deploy": "gh-pages --dist ./build --message \"chore(gh-pages): updates\"",
